<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NeonPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryVariant">@color/neon_cyan_dim</item>
        <item name="colorOnPrimary">@color/neon_bg</item>
        <item name="colorSecondary">@color/neon_magenta</item>
        <item name="colorSecondaryVariant">@color/neon_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/neon_bg</item>
        <item name="android:navigationBarColor">@color/neon_bg</item>
        <item name="android:windowBackground">@color/neon_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/NeonButton</item>
    </style>

    <style name="NeonButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/neon_cyan</item>
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="NeonPanelTitle">
        <item name="android:textColor">@color/neon_cyan</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
